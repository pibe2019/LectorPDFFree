<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sin ningun <uses-permission>: ni almacenamiento ni INTERNET. El acceso a cada PDF lo concede
        el sistema al elegirlo el usuario. Consecuencias: ficha de "Seguridad de los datos" en Play
        = "no recopila ni comparte datos", y nada que justificar en la revision de permisos.
    -->

    <application
        android:name=".MyPdfFreeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPDFFree">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyPDFFree.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Aparece en "Abrir con..." para cualquier PDF que otra app comparta por content:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>
