<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mismo motivo que backup_rules.xml, para la nube y para la transferencia entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="my_pdf_free.db" />
        <exclude domain="database" path="my_pdf_free.db-shm" />
        <exclude domain="database" path="my_pdf_free.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="my_pdf_free.db" />
        <exclude domain="database" path="my_pdf_free.db-shm" />
        <exclude domain="database" path="my_pdf_free.db-wal" />
    </device-transfer>
</data-extraction-rules>
