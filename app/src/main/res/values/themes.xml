<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de la ventana: lo que se ve antes de que Compose pinte el primer frame. Toda la UI usa
        MaterialTheme (Compose); aqui solo importa que el fondo coincida con el modo claro/oscuro
        (ver values-night) para que no haya un destello blanco al abrir en tema oscuro.
    -->
    <style name="Theme.MyPDFFree" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash (core-splashscreen): mismo aspecto en Android 8 a 16. -->
    <style name="Theme.MyPDFFree.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyPDFFree</item>
    </style>
</resources>
